# Pipeline hosted API — environment. Copy to .env and fill in.
# Generate values locally; never commit real secrets.

# ── Required in production ───────────────────────────────────────────────────
# 32-byte base64 master key that wraps mail tokens at rest (envelope encryption).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PIPELINE_MASTER_KEY=

# Managed Postgres — HOSTED deploys only; keep commented for local use. ANY set
# value (even a placeholder) switches the API out of local ~/.pipeline
# persistence and makes it dial that URL at startup, so following the guide's
# `cp .env.example .env` + `source .env` with this line active kills the app.
# If unset, the API falls back to in-process PGlite. For a single-user LOCAL
# setup, point PGLITE_DIR at a folder so your connections and board survive
# restarts (otherwise PGlite is in-memory and resets each run).
# DATABASE_URL=postgres://user:password@host:5432/pipeline
# PGLITE_DIR=.pipeline-data

# ── OAuth (YOUR client IDs) — needed to connect real mailboxes ───────────────
# Step-by-step Google/Microsoft app registration: see CONNECT-MAILBOX.md.
# Google "Web application" client (restricted gmail.readonly scope → verification/CASA before public launch).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft public client (PKCE, no secret).
MS_CLIENT_ID=
# Microsoft sign-in audience. Default "consumers" = personal Outlook/Hotmail/Live.
# Use "common" (personal + work/school) or "organizations" for a work mailbox.
# MS_TENANT=consumers
# Where the API is reachable (used to build OAuth redirect URIs) and where to send
# users back. HOSTED deploys only — keep commented locally, where the defaults
# PUBLIC_URL=http://localhost:3001 and WEB_URL=http://localhost:5173 apply.
# PUBLIC_URL=https://api.yourdomain.com
# WEB_URL=https://app.yourdomain.com

# ── Mobile / bearer identity (Clerk) ─────────────────────────────────────────
# Setting CLERK_ISSUER turns on Bearer-token auth for mobile clients (the web
# cookie flow keeps working beside it). Find it in the Clerk dashboard — it is
# the instance's Frontend API URL, e.g. https://your-app.clerk.accounts.dev
# CLERK_ISSUER=
# Optional JWKS override (defaults to `${CLERK_ISSUER}/.well-known/jwks.json`).
# CLERK_JWKS_URL=
# Optional comma-separated azp allowlist (your app's origins).
# CLERK_AUTHORIZED_PARTIES=
# Enables IdP-side user deletion for DELETE /api/account (Clerk backend API).
# CLERK_SECRET_KEY=
# Universal link a MOBILE-started mail-OAuth flow returns to after the callback
# (the phone app owns this path). Defaults to `${WEB_URL}/connect/done`.
# MOBILE_REDIRECT_URL=https://app.yourdomain.com/connect/done
# Force-upgrade gate served by GET /api/meta (phones below it must update).
# MIN_MOBILE_VERSION=0.0.0
# Gmail launch flag: "false" ships Microsoft-first while Google's restricted-scope
# verification is pending; flip to "true" (or just configure Google) when granted.
# FEATURE_GMAIL_CONNECT=
# Dev login is FAIL-CLOSED under NODE_ENV=production; this is the explicit
# staging escape hatch. Never set it on a public deploy.
# ENABLE_DEV_LOGIN=

# ── Billing (Merchant of Record: Lemon Squeezy / Paddle) ─────────────────────
# Shared secret to verify webhook HMAC signatures.
BILLING_WEBHOOK_SECRET=
# Ed25519 license keys (PEM). Public verifies in-app; private signs licenses.
#   node -e "const {generateKeyPairSync}=require('crypto');const {publicKey,privateKey}=generateKeyPairSync('ed25519');console.log(publicKey.export({type:'spki',format:'pem'}).toString());console.log(privateKey.export({type:'pkcs8',format:'pem'}).toString())"
PIPELINE_LICENSE_PUBLIC_KEY=
PIPELINE_LICENSE_PRIVATE_KEY=
